# ── Database ──────────────────────────────────────────────
# Postgres connection string (use the pooled URL from Neon/Supabase in production)
DATABASE_URL="postgresql://user:pass@localhost:5432/techstore"

# ── Auth.js v5 ────────────────────────────────────────────
# Encrypts JWTs/cookies. Must be named AUTH_SECRET (NOT BETTER_AUTH_SECRET).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google OAuth Client, from Google Cloud Console.
# Redirect URI (local): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Bosta (shipping) ──────────────────────────────────────
# From business.bosta.co -> Settings -> API Integration.
# Use an enabled Read/Write key to create deliveries; Full Access also permits cancellation.
# Paste the API key itself (Authorization uses the raw key, without a Bearer prefix).
BOSTA_API_KEY=""
# Defaults to production: https://app.bosta.co. The API key must match this environment.
# For staging, use https://stg-app.bosta.co with a key created for staging.
# Production keys are rejected by staging even when the location dropdowns work.
# Next.js loads .env files; put these settings in .env and restart npm run dev after changes.
# BOSTA_BASE_URL="https://app.bosta.co"
# Your own secret string — set this same value as the custom Authorization
# header in Bosta's dashboard (Settings -> API Integration -> Set Up Your
# Webhook). Read back from the x-webhook-secret request header.
BOSTA_WEBHOOK_SECRET=""

# ── Paymob (payments) ─────────────────────────────────────
# From Paymob dashboard -> Developers
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_HMAC_SECRET=""
# From Paymob dashboard -> Payment Integrations
PAYMOB_INTEGRATION_ID_CARD=""
PAYMOB_INTEGRATION_ID_WALLET=""
# Optional. Defaults to https://accept.paymob.com
# Optional — defaults to https://accept.paymob.com if unset.
# PAYMOB_BASE_URL=

# ── Cloudinary (image hosting) ────────────────────────────
# From Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
# Never exposed to the browser — used server-side only (signed uploads, etc.)
CLOUDINARY_API_SECRET=""

# ── Shipping cost overrides (optional) ────────────────────
# Subtotal (EGP) at/above which shipping becomes free.
FREE_SHIPPING_THRESHOLD=3000
# Flat fallback fee (EGP) used only when a governorate has no ShippingRate
# row yet in /admin/shipping-rates.
DEFAULT_SHIPPING_FEE=75

# Optional — fixes the Paymob callback/redirect URLs to this exact origin
# instead of trusting the incoming request's Host header. Not needed on
# Vercel (it sets Host correctly); set this if you self-host behind a
# reverse proxy. No trailing slash, e.g. https://shop.example.com
# APP_URL=

# ── Unpaid-order expiry job (optional) ────────────────────
# Minutes an online-payment order (card/wallet) can sit unpaid before the
# /api/cron/expire-unpaid-orders job cancels it and restores stock. COD
# orders are never touched by this. Defaults to 60 if unset.
UNPAID_ORDER_EXPIRY_MINUTES=60
# Required for the cron job to run at all — Vercel sends this as
# "Authorization: Bearer <value>" when it calls scheduled routes (see
# vercel.json). Generate one the same way as AUTH_SECRET.
CRON_SECRET=

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Tech Store <noreply@example.com>"

# ── Seed safety ───────────────────────────────────────────
# Required only when creating missing demo accounts. Reruns preserve passwords.
SEED_PASSWORD=""
# Seeding adds missing demo records and never deletes existing data.
