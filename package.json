{
  "name": "tech_store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:db": "node scripts/run-database-tests.mjs",
    "check:config": "tsx scripts/check-config.ts",
    "db:deploy": "prisma migrate deploy",
    "test:seed": "tsx --test prisma/seed.test.ts",
    "test:guest-orders": "tsx --test lib/guest-order-access.test.ts",
    "test:checkout": "tsx --test lib/bundle-discount.test.ts",
    "test:returns": "tsx --test lib/return-quantities.test.ts",
    "test:permissions": "tsx --test lib/permissions.test.ts",
    "test:refund": "tsx --test lib/refund-accounting.test.ts lib/paymob-refund.test.ts lib/order-loyalty-compensation.test.ts",
    "test:sessions": "tsx --test lib/session-policy.test.ts",
    "test:cloudinary": "tsx --test lib/cloudinary-upload-policy.test.ts",
    "test:expiry": "tsx --test lib/order-expiry.test.ts",
    "test:revenue": "tsx --test lib/cash-reporting.test.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/pg": "^8.23.1",
    "@vercel/functions": "^3.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.5",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.15"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.2": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true
  }
}
